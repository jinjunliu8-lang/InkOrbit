{
  "manifest_version": 3,
  "name": "InkOrbit - AI 答案批注",
  "version": "0.4.9",
  "description": "用悬浮墨环和数位笔直接在 ChatGPT 回答上圈画批注，数据仅保存在本机。",
  "action": {
    "default_title": "InkOrbit（墨环）"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
